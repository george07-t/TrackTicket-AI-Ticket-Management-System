# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/ticketdb

# ─── JWT ────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── AI ─────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here

# ─── Email (Gmail SMTP example) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password       # Gmail App Password (not your real password)
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=TrackTicket Support

# ─── App ────────────────────────────────────────────────────
APP_NAME=TrackTicket
FRONTEND_ORIGIN=http://localhost:3000
OTP_EXPIRE_MINUTES=10

# ─── PostgreSQL container ────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ticketdb
